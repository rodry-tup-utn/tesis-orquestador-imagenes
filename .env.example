# Credenciales de la Base de Datos (acceso desde el host)
DB_USER=admin
DB_PASSWORD=
DB_NAME=orquestador_db
DB_HOST=localhost
DB_PORT=5434

# Conexion del backend a PostgreSQL por la red interna de Docker.
# POSTGRES_PORT debe ser 5432 (puerto interno del contenedor), NO el publicado.
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=orquestador_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Configuracion de n8n
N8N_ENCRYPTION_KEY=generar_una_clave_larga
N8N_USER_EMAIL=
N8N_USER_PASSWORD=
URL_WEBHOOK_N8N=http://n8n:5678/webhook/<id-del-webhook-de-alertas>

# Configuracion Orthanc
ORTHANC_USER=orthanc_admin
ORTHANC_PASS=CAMBIAR_ESTA_CLAVE

# Canal de alertas
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Autenticacion del MVP. No versionar el .env real.
AUTH_USERNAME=admin
AUTH_PASSWORD=
INTERNAL_API_KEY=
ALERT_WEBHOOK_KEY=

# Clave JWT del backend. Generar una distinta por despliegue:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Clave separada para HMAC-SHA256 de seudonimos.
# Generar una distinta por despliegue:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYM_SECRET=
