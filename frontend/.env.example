# URL base de la API backend.
# Ruta relativa -> nginx redirige /api al backend (backend:8000) en Docker.
# En dev (vite) el proxy de vite.config.ts resuelve /api a localhost:8000.
VITE_API_URL=/api

# (Opcional) URL del WebSocket de tiempo real.
# Si se omite, se deriva de window.location + "/ws"
# (en dev lo proxya Vite con ws:true; en prod nginx hace lo mismo).
# Ej: VITE_WS_URL=ws://localhost:8000/ws
# VITE_WS_URL=
